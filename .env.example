# MediScribe AI Environment Configuration
# Copy this file to .env and configure your variables

# Hugging Face Access Token for pyannote speaker diarization
# Required models:
# 1. Accept conditions at: https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. Accept conditions at: https://huggingface.co/pyannote/segmentation-3.0
# 3. Create a User Access Token (read permissions) at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Fine-tuned Hinglish LoRA Transcription Engine
# If enabled, uses the fine-tuned PolyWhisper model (models/hinglish_adapter.zip)
# for transcription, leaving the clinical NER and documentation pipeline unchanged.
USE_HINGLISH_ADAPTER=true
HINGLISH_ADAPTER_PATH=models/hinglish_adapter.zip

# WhisperX execution settings (fallback or alternative)
# Model choices: tiny, base, small, medium, large-v2, large-v3 (default: small)
WHISPER_MODEL=small

# Compute type: int8, float16, float32 (CPU execution uses int8 by default)
WHISPER_COMPUTE_TYPE=int8

# Device: cpu or cuda
WHISPER_DEVICE=cpu

# Audio upload limit in Megabytes (default: 50)
MAX_AUDIO_SIZE_MB=50

# FFmpeg executable path — only required on Windows if ffmpeg is not on PATH.
# Set this to the full path of ffmpeg.exe.  The backend will automatically
# prepend its parent directory to PATH so WhisperX can find the binary.
# Example (Windows manual install):
# FFMPEG_PATH=C:\Users\YourName\Downloads\ffmpeg-7.0-essentials_build\bin\ffmpeg.exe
FFMPEG_PATH=
